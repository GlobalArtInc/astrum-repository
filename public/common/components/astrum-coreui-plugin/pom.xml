
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.globalart.astrum.common.components</groupId>
    <artifactId>astrum-common-components-parent</artifactId>
    <version>3.96.4-01</version>
  </parent>

  <artifactId>astrum-coreui-plugin</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>

  <properties>
    <sonar.sources>src/main/java,src/main/resources/static/rapture</sonar.sources>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-ui-plugin</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-plugin-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-capability</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-repository-services</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-repository-content</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-rapture</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-extdirect</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-siesta</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-security</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-blobstore-s3</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-test-common</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-testsupport</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-script</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-script-plugin</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>pl.pragmatists</groupId>
      <artifactId>JUnitParams</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <!-- org.globalart.astrum.coreui.internal.content:org.globalart.astrum.coreui.internal.capability -->
          <excludePackageNames>org.globalart.astrum.coreui:org.globalart.astrum.coreui.internal:org.globalart.astrum.coreui.internal.*:org.globalart.astrum.coreui.service</excludePackageNames>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>add-react-sources</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <zip destfile="${project.build.directory}/${project.artifactId}-${project.version}-sources.jar"
                     update="true">
                  <zipfileset dir="${project.basedir}/src/frontend" prefix="${project.artifactId}/src/frontend"/>
                  <zipfileset dir="${project.basedir}/src/art" prefix="${project.artifactId}/src/art"/>
                  <zipfileset dir="${project.basedir}" includes=".swcrc" prefix="${project.artifactId}"/>
                  <zipfileset dir="${project.basedir}" includes="rspack*.js" prefix="${project.artifactId}"/>
                  <zipfileset dir="${project.basedir}" includes="package.json" prefix="${project.artifactId}"/>
                  <!-- Include yarn lock from root for building -->
                  <zipfileset dir="${project.basedir}/../../" includes="yarn.lock" prefix="${project.artifactId}/"/>
                </zip>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.globalart.astrum.common.maven.plugins</groupId>
        <artifactId>extjs-maven-plugin</artifactId>
        <configuration>
          <namespace>AS.coreui</namespace>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.globalart.plugins</groupId>
        <artifactId>yuicompressor-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>

        <executions>
          <execution>
            <id>js-unit-test</id>
            <goals>
              <goal>corepack</goal>
            </goals>
            <phase>test</phase>
            <configuration>
              <arguments>yarn test --silent --reporters=jest-junit --reporters=default</arguments>
              <skip>${npm.skipTests}</skip>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>public</id>
      <activation>
        <property>
          <name>public</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.eirslett</groupId>
            <artifactId>frontend-maven-plugin</artifactId>

            <executions>
              <!--
                DO NOT skip yarn install here!

                Maven clean deletes target/ including node installation. The frontend-maven-plugin
                must run yarn install to restore node_modules after clean, otherwise yarn build-all
                fails with "Couldn't find the node_modules state file".

                Running yarn install twice (once at root via script, once per module via Maven) is
                expected and safe due to Yarn's caching.

                See: ASTRUM-52614
              -->
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
