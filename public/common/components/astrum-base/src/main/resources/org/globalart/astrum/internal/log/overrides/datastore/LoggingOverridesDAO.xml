<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.globalart.astrum.internal.log.overrides.datastore.LoggingOverridesDAO">

  <insert id="createSchema">
    CREATE TABLE IF NOT EXISTS logging_overrides (
      id INTEGER GENERATED BY DEFAULT AS IDENTITY,
      name VARCHAR(256) NOT NULL,
      level VARCHAR(256) NOT NULL,

      CONSTRAINT pk_logging_overrides_id PRIMARY KEY (id)
      );

    <!-- Index handled by LoggingOverridesIndexMigrationStep_2_44 to avoid lock contention (ASTRUM-49154) -->
  </insert>

  <insert id="createRecord" parameterType="LoggingOverridesData">
    INSERT INTO logging_overrides (name, level)
    VALUES (#{name}, #{level});
  </insert>

  <select id="readRecords" resultType="org.globalart.astrum.internal.log.overrides.datastore.LoggingOverridesData" >
    SELECT id, name, level FROM logging_overrides
    <if test="continuationToken != null">WHERE id > #{continuationToken}</if>
  </select>

  <update id="updateRecord" parameterType="LoggingOverridesData">
    UPDATE logging_overrides
    SET level = #{level}
    WHERE name = #{name}
  </update>

  <delete id="deleteRecord">
    DELETE FROM logging_overrides
    WHERE name = #{name};
  </delete>

  <delete id="deleteAllRecords">
    DELETE FROM logging_overrides
  </delete>

</mapper>
