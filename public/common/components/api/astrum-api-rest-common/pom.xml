
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.globalart.astrum.common.components</groupId>
    <artifactId>astrum-common-components-api-parent</artifactId>
    <version>2.0.0</version>
  </parent>

  <artifactId>astrum-api-rest-common</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>

  <dependencies>
    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-rest</artifactId>
    </dependency>

    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-blobstore-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-blobstore</artifactId>
    </dependency>
    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-blobstore-file</artifactId>
    </dependency>
    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-blobstore-s3</artifactId>
    </dependency>
    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-test-common</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ASTRUM-46395: replaced jersey-common (Jersey 2.22, javax-era; ships no
         META-INF/services/jakarta.ws.rs.ext.RuntimeDelegate) with resteasy-core,
         which is the JAX-RS implementation we actually use at runtime and provides
         org.jboss.resteasy.core.providerfactory.ResteasyProviderFactoryImpl as the
         RuntimeDelegate via ServiceLoader. StatusResourceTest constructs Response
         objects, which trigger RuntimeDelegate resolution; without this dep the
         tests blew up with "Provider for jakarta.ws.rs.ext.RuntimeDelegate cannot
         be found". -->
    <dependency>
      <groupId>org.jboss.resteasy</groupId>
      <artifactId>resteasy-core</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

</project>
