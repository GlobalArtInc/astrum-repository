<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.globalart.astrum.common.components</groupId>
    <artifactId>astrum-common-components-api-parent</artifactId>
    <version>2.0.0</version>
  </parent>

  <artifactId>astrum-rest</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>

  <dependencies>
    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-common</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-validation</artifactId>
    </dependency>

    <!-- ASTRUM-46395: javax.ws.rs-api replaced by jakarta.ws.rs-api (JAX-RS 3.1) -->
    <dependency>
      <groupId>jakarta.ws.rs</groupId>
      <artifactId>jakarta.ws.rs-api</artifactId>
    </dependency>

    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-testsupport</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.jboss.resteasy</groupId>
      <artifactId>resteasy-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>


  <build>
    <plugins>
      <plugin>
        <groupId>dev.aspectj</groupId>
        <artifactId>aspectj-maven-plugin</artifactId>
        <configuration>
          <aspectLibraries combine.self="override">
            <aspectLibrary>
              <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-common</artifactId>
            </aspectLibrary>
            <aspectLibrary>
              <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-validation</artifactId>
            </aspectLibrary>
          </aspectLibraries>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
