
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.globalart.astrum.common.components</groupId>
    <artifactId>astrum-common-components-parent</artifactId>
    <version>2.0.0</version>
  </parent>

  <artifactId>astrum-blobstore-file</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>

  <dependencies>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-common</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-blobstore</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-blobstore-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-thread</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-scheduling</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-datastore-mybatis</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>com.squareup</groupId>
      <artifactId>tape</artifactId>
    </dependency>

    <dependency>
      <groupId>io.dropwizard.metrics</groupId>
      <artifactId>metrics-annotation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-testsupport</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-test-db</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-upgrade</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>dev.aspectj</groupId>
        <artifactId>aspectj-maven-plugin</artifactId>
        <configuration>
          <aspectLibraries combine.children="append">
            <aspectLibrary>
              <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-blobstore</artifactId>
            </aspectLibrary>
          </aspectLibraries>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
