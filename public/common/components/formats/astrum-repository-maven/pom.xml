
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.globalart.astrum.common.components</groupId>
    <artifactId>astrum-common-components-formats-parent</artifactId>
    <version>3.96.4-01</version>
  </parent>

  <artifactId>astrum-repository-maven</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>

  <dependencies>
    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-plugin-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-rapture</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-cleanup</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-repository-content</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-upgrade</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-blobstore-tasks</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-model</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-repository-metadata</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-util</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-spi</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.maven.indexer</groupId>
      <artifactId>indexer-reader</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.maven.archetype</groupId>
      <artifactId>archetype-catalog</artifactId>
    </dependency>

    <dependency>
      <groupId>org.codehaus.plexus</groupId>
      <artifactId>plexus-xml</artifactId>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-testsupport</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.globalart.astrum.common.components</groupId>
      <artifactId>astrum-test-db</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <excludePackageNames>org.globalart.astrum.content.maven.upgrade</excludePackageNames>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.globalart.astrum.common.maven.plugins</groupId>
        <artifactId>extjs-maven-plugin</artifactId>
        <configuration>
          <namespace>AS.maven</namespace>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.globalart.plugins</groupId>
        <artifactId>yuicompressor-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>plugin-css</id>
            <phase>none</phase> <!-- no css -->
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
