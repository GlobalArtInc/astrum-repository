    <!--
    Do not change the order of BouncyCastle FIPS and non-FIPS dependencies below.
    The classloader uses the first matching provider found, so order affects which implementation is loaded.
    Changing this order may break cryptographic operations or FIPS compliance.
    -->

    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
    </dependency>

    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpg-jdk18on</artifactId>
    </dependency>

    <dependency>
