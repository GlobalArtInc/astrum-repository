


<!DOCTYPE html>
<html lang="en">
<head>
  <title>Describe $path - GlobalArt Astrum Repository</title>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>

#* START favicon links and meta
 * favicon set for multiple browsers, OS shortcuts, etc.
 * Generated at Real Favicon Generator, https://realfavicongenerator.net/
 *
 * Associated files not referenced explicitly in link or meta tags:
 *    mstile-*.png      - Win8+ desktop support
 *    browserconfig.xml - Win8+ desktop support
 *    apple-touch-icon.png  - OSX Safari desktop support
*#
## Safari on MacOS and iOS
  <link rel="icon" type="image/png" href="$raptureUrl/resources/safari-favicon-32x32.png?$urlSuffix" sizes="32x32">
  <link rel="mask-icon" href="$raptureUrl/resources/favicon-white.svg?$urlSuffix" color="#6D5EF5">
## classic favicon, shown in browser tabs
  <link rel="icon" type="image/png" href="$raptureUrl/resources/favicon.svg?$urlSuffix" sizes="16x16">
## END favicon links

  <link rel="stylesheet" type="text/css" href="$relativePath/static/css/astrum-content.css?$urlSuffix"/>

  #macro(table $map)
    #if($map.isEmpty())
      <p>No entries</p>
    #else
      <table>
        <thead>
        <tr>
          <th>Key</th>
          <th>Value</th>
        </tr>
        </thead>
        <tbody>
          #foreach ($entry in $map.entrySet())
          <tr>
            <td>$esc.html($entry.key)</td>
            <td>$esc.html($entry.value)</td>
          </tr>
          #end
        </tbody>
      </table>
    #end
  #end
</head>
<body>
<div class="astrum-header">
  <a href="$relativePath">
    <div class="product-logo">
      <img src="$relativePath/static/rapture/resources/astrum-reverse-icon.png?$urlSuffix" alt="Product logo"/>
    </div>
    <div class="product-id">
      <div class="product-id__line-1">
        <span class="product-name">GlobalArt Astrum Repository</span>
      </div>
      <div class="product-id__line-2">
        <span class="product-spec">$astrumBrandedEditionAndVersion</span>
      </div>
    </div>
  </a>
</div>

<div class="astrum-body">
  <div class="content-header">
    <img src="$relativePath/static/rapture/resources/icons/x32/bug.png?$urlSuffix" alt="Bug image"/>
    <span class="title">Describe</span>
    <span class="description">$path</span>
  </div>

  <div class="content-body">
    <div class="content-section">
      This page describes the processing of a request made by external client,
      using information from the request, retrieved item (or exception if not item was retrieved)
      and some intermittent processing states.
    </div>

    <div class="content-section">
      #foreach ($item in $items)
        #if($item.type == "topic")
          <h2>$esc.html($item.name)</h2>
        #elseif($item.type == "string")
          <h3>$esc.html($item.name)</h3>
          <p>$esc.html($item.value)</p>
        #elseif($item.type == "table")
          <h3>$esc.html($item.name)</h3>
          #table($item.value)
        #end
      #end
    </div>
  </div>
</body>
</html>
