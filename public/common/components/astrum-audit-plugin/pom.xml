    <!-- ASTRUM-46395: replaced jersey-common (Jersey 2.22, javax-era; ships no
         META-INF/services/jakarta.ws.rs.ext.RuntimeDelegate) with resteasy-core,
         which is the JAX-RS implementation we actually use at runtime and provides
         org.jboss.resteasy.core.providerfactory.ResteasyProviderFactoryImpl as the
         RuntimeDelegate via ServiceLoader. AuditLogResourceTest constructs Response
         objects (e.g. Response.ok(...).build()), which trigger RuntimeDelegate
         resolution; without this dep the tests blew up with
         "Provider for jakarta.ws.rs.ext.RuntimeDelegate cannot be found". -->
    <dependency>
      <groupId>org.jboss.resteasy</groupId>
      <artifactId>resteasy-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

