  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-dependencies</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <fail>true</fail>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes combine.children="append">
                    <!-- Ban private -->
                    <exclude>com.globalart.astrum*</exclude>
                    <!--
                      ASTRUM-46395: ban Java EE 8 (javax.*) coordinates that have Jakarta EE 10
                      replacements. The runtime is fully Jakarta-native; these guard against any
                      future dependency change accidentally re-introducing javax-* artifacts.
                      Replacements (mechanical groupId/package rename per Jakarta EE 9+ spec):
                        javax.servlet:*     -> jakarta.servlet:*
                        javax.inject:*      -> jakarta.inject:*
                        javax.ws.rs:*       -> jakarta.ws.rs:*
                        javax.validation:*  -> jakarta.validation:*
                        javax.enterprise:*  -> jakarta.enterprise:*       (CDI)
                        javax.el:*          -> jakarta.el:*               (Expression Language)
                        javax.interceptor:* -> jakarta.interceptor:*
                        javax.transaction:* -> jakarta.transaction:*      (JTA)
                        javax.xml.bind:*    -> jakarta.xml.bind:*         (JAXB)
                        javax.activation:*  -> jakarta.activation:*       (Jakarta Activation)
                        javax.mail:*        -> jakarta.mail:*             (Jakarta Mail; note our
                                                                          Mail impl ships at
                                                                          com.sun.mail:jakarta.mail,
                                                                          a different groupId)
                      Intentionally NOT banned:
                        javax.annotation:*  Google Cloud gRPC stubs emit @javax.annotation.Generated
                                            on generated classes; this is a third-party transitive
                                            (via astrum-blobstore-google-cloud, only present in Pro)
                                            we can't cleanly displace. Our own code is on
                                            jakarta.annotation.{PostConstruct,PreDestroy,Resource,...}
                                            for the JSR-250 lifecycle annotations; the JSR-305 nullness
                                            annotations (javax.annotation.{Nullable,Nonnull,...}, ~960
                                            uses across the codebase) come from
                                            com.google.code.findbugs:jsr305 - a different groupId,
                                            so this ban does not affect them.
                        javax.cache:*       JSR-107 / JCache; group name unrelated to EE namespace,
                                            no Jakarta replacement exists.
                        com.google.code.findbugs:jsr305 provides javax.annotation.Nullable etc -
                                            different group, JSR-305 stays javax.* by spec.
                    -->
                    <exclude>javax.servlet:*</exclude>
                    <exclude>javax.inject:*</exclude>
                    <exclude>javax.ws.rs:*</exclude>
                    <exclude>javax.validation:*</exclude>
                    <exclude>javax.enterprise:*</exclude>
                    <exclude>javax.el:*</exclude>
                    <exclude>javax.interceptor:*</exclude>
                    <exclude>javax.transaction:*</exclude>
                    <exclude>javax.xml.bind:*</exclude>
                    <exclude>javax.activation:*</exclude>
                    <exclude>javax.mail:*</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <excludePackageNames>org.globalart.astrum.bootstrap.*</excludePackageNames>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>uberjar</id>
            <phase>package</phase>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <executable>java</executable>
          <workingDirectory>${project.build.directory}/assembly</workingDirectory>
          <arguments>
            <argument>-jar</argument>
            <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
          </arguments>
          <environmentVariables>
            <!-- Used by the `?debug` mode to allow javascript resources to be loaded from the filesystem -->
            <ASTRUM_RESOURCE_DIRS>
              ${project.parent.parent.parent.parent.basedir}/public/common/components/astrum-base/src/main/resources,
              ${project.parent.parent.parent.parent.basedir}/public/common/components/astrum-coreui-plugin/src/main/resources,
              ${project.parent.parent.parent.parent.basedir}/public/common/components/astrum-coreui-plugin/target/classes,
              ${project.parent.parent.parent.parent.basedir}/public/common/components/astrum-example-content/src/main/resources,
              ${project.parent.parent.parent.parent.basedir}/public/common/components/astrum-onboarding-plugin/src/main/resources,
              ${project.parent.parent.parent.parent.basedir}/public/common/components/astrum-rapture/src/main/resources,
              ${project.parent.parent.parent.parent.basedir}/public/common/components/astrum-rapture/target/classes,
              ${project.parent.parent.parent.parent.basedir}/public/common/components/astrum-ui-plugin/target/classes,
              ${project.parent.parent.parent.parent.basedir}/public/common/components/formats/astrum-repository-maven/src/main/resources
            </ASTRUM_RESOURCE_DIRS>
            <!-- Used to disable the random password generation, and default to admin/admin123 for easy development -->
            <ASTRUM_SECURITY_RANDOMPASSWORD>false</ASTRUM_SECURITY_RANDOMPASSWORD>
          </environmentVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <!-- parent pom sets this execution up in pluginManagement, so it will autorun by including the plugin-->
          <!-- which we don't want for this assembly as we have our own antrun execution doing the work -->
          <execution>
            <id>overlay-assembly</id>
            <configuration>
              <skip>true</skip>
            </configuration>
          </execution>
          <execution>
            <id>customize-assembly</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <unzip src="${org.globalart.astrum.common.assemblies:astrum-base-overlay:zip}"
                       dest="${project.build.directory}/assembly"
                       overwrite="true">
                  <patternset>
                    <exclude name="*/lib/**"/>
                    <exclude name="globalart-work/**"/>
                  </patternset>
                  <cutdirsmapper dirs="1"/>
                </unzip>

                <unzip src="${org.globalart.astrum.common.assemblies:astrum-base-overlay:zip}"
                       dest="${project.build.directory}/globalart-work"
                       overwrite="true">
                  <patternset>
                    <include name="globalart-work/**"/>
                  </patternset>
                  <cutdirsmapper dirs="1"/>
                </unzip>

                <!-- overlay customizations; failonerror is set because any copy fails on an empty folder -->
                <!-- preserving the command to stay consistent with other distributions and in case we re-add files -->
                <copy todir="${project.build.directory}/assembly" overwrite="true" failonerror="false">
                  <fileset dir="${project.basedir}/src/main/assembly/overlay"/>
                </copy>

                <!-- workaround maven-assembly-plugin bug where lineEnding configuration for fileSets is ineffective -->
                <fixcrlf srcdir="${project.build.directory}/assembly/bin" includes="*" excludes="*.bat" eol="unix"/>
                <fixcrlf srcdir="${project.build.directory}/assembly/bin" includes="*.bat" eol="dos"/>

                <!-- and don't forget the uberjar -->
                <copy file="${project.build.directory}/${project.artifactId}-${project.version}.jar"
                      todir="${project.build.directory}/assembly/bin" overwrite="true"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>run</id>
      <build>
        <defaultGoal>exec:exec</defaultGoal>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>run-after-package</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
